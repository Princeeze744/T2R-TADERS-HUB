# Copy into Vercel → Project → Settings → Environment Variables (never commit real values)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
T2R_INGEST_KEY=a-long-random-password-the-EA-sends
# Telegram bot (set by t2r-bot-setup.ps1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Members (optional - these are the defaults)
PRODUCT_NAME=T2R Spike Signals
TRIAL_DAYS=3
PLAN_DAYS=14
# Payments: switched on when both are set
PLAN_PRICE_NGN=
PAYSTACK_SECRET_KEY=
# Daily report and reminders (any long random text)
CRON_SECRET=
# Optional: only these exact markets go to members, comma separated
PREMIUM_MARKETS=
